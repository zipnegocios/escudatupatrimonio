# --- App ---------------------------------------------------------------
# Postgres de la app. En dev apunta al servicio `postgres` de
# docker-compose.yml expuesto en localhost:5432.
DATABASE_URL=postgres://user:password@host:port/dbname

# Secreto HS256 con el que se firman los JWT de sesión (mínimo 16 chars).
# Generar con: openssl rand -base64 32
SESSION_SECRET=

NODE_ENV=development

# --- Postgres local (solo docker-compose.yml) ---------------------------
POSTGRES_USER=smartform
POSTGRES_PASSWORD=smartform
POSTGRES_DB=smartform

# --- Seed del admin (solo `npm run seed:admin`, no se leen en runtime) --
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=Luis Moreno

# --- WhatsApp (opcional — solo si el módulo está activo) -----------------
# Secreto compartido entre `web` y `whatsapp-worker` para la API interna.
# Generar con: openssl rand -base64 32
WHATSAPP_WORKER_SECRET=
# Dentro de docker-compose es el nombre del servicio; en EasyPanel, el
# hostname interno que le asigne el panel al servicio whatsapp-worker.
WHATSAPP_WORKER_URL=http://whatsapp-worker:4001

# --- Email / Resend (opcional — solo si el módulo está activo) -----------
RESEND_API_KEY=
# Se obtiene al crear el webhook en el dashboard de Resend, apuntando a
# https://tu-dominio/api/webhooks/resend
RESEND_WEBHOOK_SECRET=
# Dirección "from", debe ser de un dominio verificado en Resend.
EMAIL_FROM_ADDRESS=notificaciones@tu-dominio.com
# A dónde llegan las notificaciones internas de "nuevo lead".
EMAIL_NOTIFY_TO=

# --- Media WhatsApp / Cloudflare R2 (opcional — fotos, audio, video) -----
# Se necesitan tanto en `web` (subir adjuntos, firmar URLs) como en
# `whatsapp-worker` (bajar y subir medios entrantes/salientes).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
